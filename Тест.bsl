&НаКлиенте
Процедура ПолучитьБаланс(Команда)

	Результаты301 = ПолучитьОборотыЗаГод(Год);

	Результаты311Кт301 = ПолучитьОбороты311Кт301ЗаГод(Год);

	Результаты311Кт3771 = ПолучитьОбороты311Кт3771ЗаГод(Год);

	Результаты949Кт311 = ПолучитьОбороты949Кт311ЗаГод(Год);

	НачальныйОстаток311 = ПолучитьНачальныйОстаток311(Год);

	ЗаписатьВExcel(
		Результаты301,
		Результаты311Кт301,
		Результаты311Кт3771,
		Результаты949Кт311,
		НачальныйОстаток311,
		Год
	);

КонецПроцедуры


&НаСервере
Функция ПолучитьНачальныйОстаток311(Год)

	Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("311");

	Организация = Справочники.Организации.НайтиПоНаименованию(
		"ОСББ ""ХЕРСОНСЬКЕ ШОСЕ,38"""
	);

	НачалоПериода = Дата(Год, 1, 1);
	КонецПериода = НачалоПериода;

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиИОбороты.СуммаНачальныйОстатокДт КАК НачальныйДт,
	|	ОстаткиИОбороты.СуммаНачальныйОстатокКт КАК НачальныйКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода,
	|		&КонецПериода,
	|		Регистратор,
	|		ДвиженияИГраницыПериода,
	|		Счет В (&Счет),
	|		,
	|		Организация = &Организация
	|	) КАК ОстаткиИОбороты";

	Запрос.УстановитьПараметр(
		"НачалоПериода",
		НачалоПериода
	);

	Запрос.УстановитьПараметр(
		"КонецПериода",
		КонецПериода
	);

	Запрос.УстановитьПараметр(
		"Счет",
		Счет
	);

	Запрос.УстановитьПараметр(
		"Организация",
		Организация
	);

	Выборка = Запрос.Выполнить().Выбрать();

	НачальныйОстаток = 0;

	Если Выборка.Следующий() Тогда

		Если ЗначениеЗаполнено(Выборка.НачальныйДт) Тогда
			НачальныйОстаток = Выборка.НачальныйДт;
		КонецЕсли;

	КонецЕсли;

	Возврат НачальныйОстаток;

КонецФункции


&НаСервере
Функция ПолучитьОборотыЗаГод(Год)

	Результаты = Новый Массив;

	Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду("301");

	Организация = Справочники.Организации.НайтиПоНаименованию(
		"ОСББ ""ХЕРСОНСЬКЕ ШОСЕ,38"""
	);

	Для НомерМесяца = 1 По 12 Цикл

		НачалоПериода = Дата(Год, НомерМесяца, 1);

		Если НомерМесяца = 12 Тогда
			КонецПериода = Дата(Год + 1, 1, 1);
		Иначе
			КонецПериода = Дата(Год, НомерМесяца + 1, 1);
		КонецЕсли;

		Запрос = Новый Запрос;

		Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ХозрасчетныйОбороты.СуммаОборотДт) КАК Дебет
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|		&НачалоПериода,
		|		&КонецПериода,
		|		Регистратор,
		|		Счет В (&Счет),
		|		,
		|		Организация = &Организация
		|	) КАК ХозрасчетныйОбороты";

		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Запрос.УстановитьПараметр("Счет", Счет);
		Запрос.УстановитьПараметр("Организация", Организация);

		Выборка = Запрос.Выполнить().Выбрать();

		Дебет = 0;

		Если Выборка.Следующий() Тогда
			Если ЗначениеЗаполнено(Выборка.Дебет) Тогда
				Дебет = Выборка.Дебет;
			КонецЕсли;
		КонецЕсли;

		СтрокаРезультата = Новый Структура;
		СтрокаРезультата.Вставить("Дебет", Дебет);

		Результаты.Добавить(СтрокаРезультата);

	КонецЦикла;

	Возврат Результаты;

КонецФункции


