&НаСервере
Функция ПолучитьОбороты949Кт311ЗаГод(Год)

	Результаты = Новый Массив;

	СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("949");
	СчетКт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("311");

	Организация = Справочники.Организации.НайтиПоНаименованию(
		"ОСББ ""ХЕРСОНСЬКЕ ШОСЕ,38"""
	);

	Для НомерМесяца = 1 По 12 Цикл

		НачалоПериода = Дата(Год, НомерМесяца, 1);

		Если НомерМесяца = 12 Тогда
			КонецПериода = Дата(Год + 1, 1, 1);
		Иначе
			КонецПериода = Дата(Год, НомерМесяца + 1, 1);
		КонецЕсли;

		Запрос = Новый Запрос;

		Запрос.Текст =
		"ВЫБРАТЬ
		|	Обороты.Субконто1 КАК Аналитика,
		|	СУММА(Обороты.СуммаОборотДт) КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|		&НачалоПериода,
		|		&КонецПериода,
		|		Регистратор,
		|		Счет В (&СчетДт),
		|		,
		|		Организация = &Организация
		|	) КАК Обороты
		|ГДЕ
		|	Обороты.КорСчет = &СчетКт
		|
		|СГРУППИРОВАТЬ ПО
		|	Обороты.Субконто1";

		Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
		Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
		Запрос.УстановитьПараметр("СчетДт", СчетДт);
		Запрос.УстановитьПараметр("СчетКт", СчетКт);
		Запрос.УстановитьПараметр("Организация", Организация);

		Выборка = Запрос.Выполнить().Выбрать();

		ВивизТПВ = 0;
		Электроэнергия = 0;
		БанковскаяКомиссия = 0;
		БухгалтерияИУборка = 0;
		Лифты = 0;
		ВодаНаПолив = 0;

		Пока Выборка.Следующий() Цикл

			Если НЕ ЗначениеЗаполнено(Выборка.Аналитика) Тогда
				Продолжить;
			КонецЕсли;

			Аналитика = Строка(Выборка.Аналитика);

			Если Аналитика = "вивіз ТПВ" Тогда

				ВивизТПВ = ВивизТПВ + Выборка.Сумма;

			ИначеЕсли Аналитика = "електроенергія" Тогда

				Электроэнергия = Электроэнергия + Выборка.Сумма;

			ИначеЕсли Аналитика = "банківська комісія" Тогда

				БанковскаяКомиссия =
					БанковскаяКомиссия + Выборка.Сумма;

			ИначеЕсли Аналитика =
				"оплата за ведення бух. обліку та прибирання будинка та прибудинкових території" Тогда

				БухгалтерияИУборка =
					БухгалтерияИУборка + Выборка.Сумма;

			ИначеЕсли Аналитика =
				"технічне обслуговування ліфтів" Тогда

				Лифты = Лифты + Выборка.Сумма;

			ИначеЕсли Аналитика = "за воду на полив" Тогда

				ВодаНаПолив = ВодаНаПолив + Выборка.Сумма;

			КонецЕсли;

		КонецЦикла;

		СтрокаРезультата = Новый Структура;

		СтрокаРезультата.Вставить("ВивизТПВ", ВивизТПВ);
		СтрокаРезультата.Вставить("Электроэнергия", Электроэнергия);
		СтрокаРезультата.Вставить("БанковскаяКомиссия", БанковскаяКомиссия);
		СтрокаРезультата.Вставить("БухгалтерияИУборка", БухгалтерияИУборка);
		СтрокаРезультата.Вставить("Лифты", Лифты);
		СтрокаРезультата.Вставить("ВодаНаПолив", ВодаНаПолив);

		Результаты.Добавить(СтрокаРезультата);

	КонецЦикла;

	Возврат Результаты;

КонецФункции


&НаСервере
Процедура ЗаписатьВExcel(
	Результаты301,
	Результаты311Кт301,
	Результаты311Кт3771,
	Результаты949Кт311,
	НачальныйОстаток311,
	Год
)

	ПутьКФайлу = "D:\баланс.xlsx";

	Excel = Новый COMОбъект("Excel.Application");

	Excel.Visible = Истина;

	Книга = Excel.Workbooks.Open(ПутьКФайлу);

	Лист = Книга.Worksheets("отчет");


	// ==========================================
	// Годы для заголовков
	// ==========================================

	ПредыдущийГод = Год - 1;

	СтрокаГода = Формат(Год, "ЧГ=0");

	ДатаПредыдущегоГода =
		"31.12." + Формат(ПредыдущийГод, "ЧГ=0") + "р.";


	// ==========================================
	// Заголовок отчета по расчетному счету -> A2
	// ==========================================

	Лист.Cells(2, 1).Value =
		"Звіт по руху грошових коштів по розрахунковому рахунку за "
		+ СтрокаГода + "р.";


	// ==========================================
	// Заголовок отчета по касе -> A38
	// ==========================================

	Лист.Cells(38, 1).Value =
		"Звіт по руху грошових коштів по касі за "
		+ СтрокаГода + "р.";


	// ==========================================
	// Заголовок взаиморасчетов -> A54
	// ==========================================

	Лист.Cells(54, 1).Value =
		"Звіт стану взаєморозрахунків по внесках співвласників за "
		+ СтрокаГода + "р.";


	// ==========================================
	// Текст остатка на расчетном счете -> A4
	// ==========================================

	Лист.Cells(4, 1).Value =
		"Залишок грошових коштів на р/р на "
		+ ДатаПредыдущегоГода;


	// ==========================================
	// Текст остатка в кассе -> A40
	// ==========================================

	Лист.Cells(40, 1).Value =
		"Залишок грошових коштів в касі станом на "
		+ ДатаПредыдущегоГода;


	// ==========================================
	// Текст задолженности -> A56
	// ==========================================

	Лист.Cells(56, 1).Value =
		"Залишок заборгованності зі сплати внесків станом на "
		+ ДатаПредыдущегоГода;


	// ==========================================
	// Начальный остаток 311 -> B4
	// ==========================================

	Если НачальныйОстаток311 <> 0 Тогда

		Лист.Cells(4, 2).Value =
			НачальныйОстаток311;

	Иначе

		Лист.Cells(4, 2).ClearContents();

	КонецЕсли;


	Для НомерМесяца = 1 По 12 Цикл

		НомерКолонки = НомерМесяца + 2;


		// ==========================================
		// Дт 301 -> строки 43 и 59
		// ==========================================

		Строка301 = Результаты301[НомерМесяца - 1];

		Если Строка301.Дебет <> 0 Тогда

			Лист.Cells(43, НомерКолонки).Value =
				Строка301.Дебет;

			Лист.Cells(59, НомерКолонки).Value =
				Строка301.Дебет;

		Иначе

			Лист.Cells(43, НомерКолонки).ClearContents();
			Лист.Cells(59, НомерКолонки).ClearContents();

		КонецЕсли;


		// ==========================================
		// Дт 311 / Кт 301 -> строки 46 и 8
		// ==========================================

		Строка311Кт301 =
			Результаты311Кт301[НомерМесяца - 1];

		Если Строка311Кт301.Сумма <> 0 Тогда

			Лист.Cells(46, НомерКолонки).Value =
				Строка311Кт301.Сумма;

			Лист.Cells(8, НомерКолонки).Value =
				Строка311Кт301.Сумма;

		Иначе

			Лист.Cells(46, НомерКолонки).ClearContents();
			Лист.Cells(8, НомерКолонки).ClearContents();

		КонецЕсли;


		// ==========================================
		// Дт 311 / Кт 3771 -> строки 7 и 60
		// ==========================================

		Строка311Кт3771 =
			Результаты311Кт3771[НомерМесяца - 1];

		Если Строка311Кт3771.Сумма <> 0 Тогда

			Лист.Cells(7, НомерКолонки).Value =
				Строка311Кт3771.Сумма;

			Лист.Cells(60, НомерКолонки).Value =
				Строка311Кт3771.Сумма;

		Иначе

			Лист.Cells(7, НомерКолонки).ClearContents();
			Лист.Cells(60, НомерКолонки).ClearContents();

		КонецЕсли;


		// ==========================================
		// Дт 949 / Кт 311
		// ==========================================

		Строка949Кт311 =
			Результаты949Кт311[НомерМесяца - 1];


		// вивіз ТПВ -> строка 13

		Если Строка949Кт311.ВивизТПВ <> 0 Тогда

			Лист.Cells(13, НомерКолонки).Value =
				Строка949Кт311.ВивизТПВ;

		Иначе

			Лист.Cells(13, НомерКолонки).ClearContents();

		КонецЕсли;


		// електроенергія -> строка 14

		Если Строка949Кт311.Электроэнергия <> 0 Тогда

