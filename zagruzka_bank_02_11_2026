&НаКлиенте
Процедура ЗагрузитьБанк(Команда)

    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
    Диалог.Заголовок = "Выберите файл банка";
    Диалог.МножественныйВыбор = Ложь;
    Диалог.Фильтр = "Файлы Excel (*.xlsx; *.xlsm)|*.xlsx;*.xlsm";

    Если Не Диалог.Выбрать() Тогда
        Возврат;
    КонецЕсли;

    ИмяФайла = Диалог.ПолноеИмяФайла;

    Результат = ЗагрузитьВсеСтрокиИзExcel(ИмяФайла);

    Если Результат <> "" Тогда
        Сообщить(Результат);
    КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗагрузитьВсеСтрокиИзExcel(ИмяФайла)

    ТабличныйДокумент = Новый ТабличныйДокумент;
    ИмяФайлаДляЧтения = ИмяФайла;
    ВременныйФайл = "";

    Попытка
        // Пытаемся прочитать файл как XLSX (это работает и для обычных .xlsx, и для .xlsm без макросов)
        ТабличныйДокумент.Прочитать(ИмяФайла, , ТипФайлаТабличногоДокумента.XLSX);
    Исключение
        // Если файл имеет расширение .xlsm и возникла ошибка, пробуем пересохранить его в XLSX через Excel
        Если НРег(Прав(ИмяФайла, 5)) = ".xlsm" Тогда
            Попытка
                ВременныйФайл = ПолучитьИмяВременногоФайла("xlsx");
                КонвертироватьXlsmВXlsx(ИмяФайла, ВременныйФайл);
                ТабличныйДокумент.Прочитать(ВременныйФайл, , ТипФайлаТабличногоДокумента.XLSX);
                ИмяФайлаДляЧтения = ВременныйФайл;
            Исключение
                // Если и это не удалось — возвращаем исходную ошибку
                Возврат "Ошибка при чтении Excel:" + Символы.ПС + ОписаниеОшибки();
            КонецПопытки;
        Иначе
            // Для всех остальных файлов возвращаем ошибку как раньше
            Возврат "Ошибка при чтении Excel:" + Символы.ПС + ОписаниеОшибки();
        КонецЕсли;
    КонецПопытки;

    // Удаляем временный файл, если он создавался
    Если ВременныйФайл <> "" Тогда
        Попытка
            УдалитьФайлы(ВременныйФайл);
        Исключение
            // Игнорируем ошибку удаления
        КонецПопытки;
    КонецЕсли;

    ОбластьДля1С = ТабличныйДокумент.Области.Найти("Для1С");

    Если ОбластьДля1С = Неопределено Тогда
        Возврат "Ошибка: в файле Excel не найден лист ""Для1С""."
            + Символы.ПС
            + "Проверьте точное название листа.";
    КонецЕсли;

    ТабличныйДокументДля1С = ТабличныйДокумент.ПолучитьОбласть(ОбластьДля1С.Имя);

    КоличествоОбработано = 0;
    КоличествоСоздано = 0;
    КоличествоОшибок = 0;
    ТекстОшибок = "";

    Для НомерСтроки = 1 По ТабличныйДокументДля1С.ВысотаТаблицы Цикл

        ДатаИзExcel = ТабличныйДокументДля1С.Область(НомерСтроки, 1, НомерСтроки, 1).Текст;
        СуммаИзExcel = ТабличныйДокументДля1С.Область(НомерСтроки, 2, НомерСтроки, 2).Текст;
        НомерКонтрагента = ТабличныйДокументДля1С.Область(НомерСтроки, 3, НомерСтроки, 3).Текст;

        Если ПустаяСтрока(ДатаИзExcel)
            И ПустаяСтрока(СуммаИзExcel)
            И ПустаяСтрока(НомерКонтрагента) Тогда
            Продолжить;
        КонецЕсли;

        КоличествоОбработано = КоличествоОбработано + 1;

        Если ПустаяСтрока(ДатаИзExcel) Тогда
            КоличествоОшибок = КоличествоОшибок + 1;
            ТекстОшибок = ТекстОшибок + "Строка " + Строка(НомерСтроки) + ": не указана дата." + Символы.ПС;
            Продолжить;
        КонецЕсли;

        Попытка
            ДатаДокумента = Дата(Прав(ДатаИзExcel, 4), Сред(ДатаИзExcel, 4, 2), Лев(ДатаИзExcel, 2));
        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            ТекстОшибок = ТекстОшибок + "Строка " + Строка(НомерСтроки) + ": неправильная дата " + ДатаИзExcel + "." + Символы.ПС;
            Продолжить;
        КонецПопытки;

        Если ПустаяСтрока(СуммаИзExcel) Тогда
            КоличествоОшибок = КоличествоОшибок + 1;
            ТекстОшибок = ТекстОшибок + "Строка " + Строка(НомерСтроки) + ": не указана сумма." + Символы.ПС;
            Продолжить;
        КонецЕсли;

        Попытка
            СуммаДокумента = Число(СуммаИзExcel);
        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            ТекстОшибок = ТекстОшибок + "Строка " + Строка(НомерСтроки) + ": неправильная сумма " + СуммаИзExcel + "." + Символы.ПС;
            Продолжить;
        КонецПопытки;

        Если ПустаяСтрока(НомерКонтрагента) Тогда
            КоличествоОшибок = КоличествоОшибок + 1;
            ТекстОшибок = ТекстОшибок + "Строка " + Строка(НомерСтроки) + ": не указан номер контрагента." + Символы.ПС;
            Продолжить;
        КонецЕсли;

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 2
        |    Контрагенты.Ссылка КАК Ссылка,
        |    Контрагенты.Наименование КАК Наименование
        |ИЗ
        |    Справочник.Контрагенты КАК Контрагенты
        |ГДЕ
        |    Контрагенты.Наименование ПОДОБНО &НачалоНаименования";

        Запрос.УстановитьПараметр("НачалоНаименования", НомерКонтрагента + ".%");

        РезультатЗапроса = Запрос.Выполнить();
        Выборка = РезультатЗапроса.Выбрать();

        КоличествоКонтрагентов = 0;
        НайденныйКонтрагент = Неопределено;
        НайденноеНаименование = "";

        Пока Выборка.Следующий() Цикл
            КоличествоКонтрагентов = КоличествоКонтрагентов + 1;
            Если КоличествоКонтрагентов = 1 Тогда
                НайденныйКонтрагент = Выборка.Ссылка;
                НайденноеНаименование = Выборка.Наименование;
            КонецЕсли;
        КонецЦикла;

        Если КоличествоКонтрагентов = 0 Тогда
            КоличествоОшибок = КоличествоОшибок + 1;
            ТекстОшибок = ТекстОшибок + "Строка " + Строка(НомерСтроки) + ": контрагент " + НомерКонтрагента + " не найден." + Символы.ПС;
            Продолжить;
        КонецЕсли;

        Если КоличествоКонтрагентов > 1 Тогда
            КоличествоОшибок = КоличествоОшибок + 1;
            ТекстОшибок = ТекстОшибок + "Строка " + Строка(НомерСтроки) + ": найдено несколько контрагентов с номером " + НомерКонтрагента + "." + Символы.ПС;
            Продолжить;
        КонецЕсли;

        Документ = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
        Документ.Дата = ДатаДокумента;
        Документ.СуммаДокумента = СуммаДокумента;
        Документ.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ПрочееПоступлениеБезналичныхДенежныхСредств;
        Документ.Организация = Справочники.Организации.НайтиПоНаименованию("ОСББ ""ХЕРСОНСЬКЕ ШОСЕ,38""");
        Документ.СчетОрганизации = Справочники.БанковскиеСчета.НайтиПоНаименованию("UA763264610000000026002300111, в АТ ""Ощадбанк""");
        Документ.Контрагент = НайденныйКонтрагент;
        Документ.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("внески співвласників");
        Документ.СчетБанк = ПланыСчетов.Хозрасчетный.НайтиПоКоду("311");
        Документ.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("3771");
        Документ.СубконтоКт1 = Документ.Контрагент;

        Попытка
            Документ.Записать(РежимЗаписиДокумента.Проведение);
            Если Документ.Проведен Тогда
                КоличествоСоздано = КоличествоСоздано + 1;
            Иначе
                КоличествоОшибок = КоличествоОшибок + 1;
                ТекстОшибок = ТекстОшибок + "Строка " + Строка(НомерСтроки) + ": документ записан, но не проведён." + Символы.ПС;
            КонецЕсли;
        Исключение
            КоличествоОшибок = КоличествоОшибок + 1;
            ТекстОшибок = ТекстОшибок + "Строка " + Строка(НомерСтроки) + ": ошибка при записи/проведении." + Символы.ПС + ОписаниеОшибки() + Символы.ПС;
        КонецПопытки;

    КонецЦикла;

    ТекстРезультата =
        "Загрузка завершена."
        + Символы.ПС
        + "Обработано строк: " + Строка(КоличествоОбработано)
        + Символы.ПС
        + "Создано и проведено: " + Строка(КоличествоСоздано)
        + Символы.ПС
        + "Ошибок: " + Строка(КоличествоОшибок);

    Если КоличествоОшибок > 0 Тогда
        ТекстРезультата = ТекстРезультата + Символы.ПС + Символы.ПС + "Ошибки:" + Символы.ПС + ТекстОшибок;
    КонецЕсли;

    Возврат ТекстРезультата;

КонецФункции

// Вспомогательная процедура: пересохраняет .xlsm в .xlsx через установленный Excel
&НаСервере
Процедура КонвертироватьXlsmВXlsx(ИсходныйФайл, ФайлНазначения)
    COMОбъект = Новый COMОбъект("Excel.Application");
    Попытка
        COMОбъект.Visible = Ложь;
        COMОбъект.DisplayAlerts = Ложь;
        Книга = COMОбъект.WorkBooks.Open(ИсходныйФайл);
        // 51 = xlOpenXMLWorkbook (.xlsx)
        Книга.SaveAs(ФайлНазначения, 51);
        Книга.Close();
        COMОбъект.Quit();
    Исключение
        Попытка
            COMОбъект.Quit();
        Исключение
            // Игнорируем
        КонецПопытки;
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
